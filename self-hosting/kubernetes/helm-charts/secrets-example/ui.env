# Taco UI Environment Variables
# Copy this file to ../.secrets/ui.env and fill in your actual values

# Dex OIDC Configuration (for authentication)
# Must match the "digger-ui" static client in your Dex config
DEX_ISSUER_URL=https://dex.your-domain.com/dex
DEX_CLIENT_ID=digger-ui
DEX_CLIENT_SECRET='YOUR_DEX_CLIENT_SECRET'
DEX_REDIRECT_URI=https://your-domain.com/api/auth/callback

# Session cookie encryption key (at least 32 characters)
SESSION_COOKIE_PASSWORD='YOUR_32_CHAR_RANDOM_STRING'

# Allowed Hosts (comma-separated list)
ALLOWED_HOSTS="your-domain.com,.ngrok-free.dev,.sslip.io,localhost"

# Public URL used by UI for hostname-derived instructions
PUBLIC_URL="https://your-domain.com"

# Backend Service URLs
# Use Kubernetes service names for in-cluster communication
# Format: http://<release-name>-<chart-name>:<port>
ORCHESTRATOR_BACKEND_URL="http://opentaco-taco-orchestrator-web:3000"
ORCHESTRATOR_BACKEND_SECRET=YOUR_ORCHESTRATOR_SECRET

DRIFT_REPORTING_BACKEND_URL=http://opentaco-taco-drift:3004
DRIFT_REPORTING_BACKEND_WEBHOOK_SECRET=YOUR_DRIFT_WEBHOOK_SECRET

STATESMAN_BACKEND_URL=http://opentaco-taco-statesman:8080
STATESMAN_BACKEND_WEBHOOK_SECRET=YOUR_STATESMAN_WEBHOOK_SECRET

TOKENS_SERVICE_BACKEND_URL=http://opentaco-taco-token-service:8081
